generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Week {
  id        String   @id @default(cuid())
  userId    String   @default("jordan")
  startDate DateTime
  intention String?
  days      Day[]
  createdAt DateTime @default(now())

  @@unique([userId, startDate])
}

model Day {
  id          String    @id @default(cuid())
  date        DateTime  @unique
  weekId      String
  week        Week      @relation(fields: [weekId], references: [id], onDelete: Cascade)
  tasks       Task[]
  debt        Debt?
  lockedAt    DateTime?
  // Lifetime unlock count for this day; capped at 1 per the "one unlock per
  // day" rule. Persists across lock→unlock→re-lock cycles, so re-locking
  // doesn't refresh the budget.
  unlockCount Int       @default(0)
  reckonedAt  DateTime?
  reflection  String?
}

model Task {
  id              String    @id @default(cuid())
  title           String
  notes           String?
  dayId           String
  day             Day       @relation(fields: [dayId], references: [id], onDelete: Cascade)
  priority        String    @default("MEDIUM") // LOW | MEDIUM | HIGH
  estimatedMins   Int?
  // Calendar slot: minutes since local 00:00. Null means "unscheduled" — kept
  // for backwards compat with rows created before the calendar feature; the
  // UI surfaces these in a tray and asks the user to schedule them.
  startMinutes    Int?
  endMinutes      Int?
  status          String    @default("PLANNED") // PLANNED | DONE | VOIDED | OWED | SETTLED
  completedAt     DateTime?
  backdated       Boolean   @default(false)
  rescheduleCount Int       @default(0)
  voidReason      String?
  position        Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// One debt per day. Triggered if ANY task on the day ends up OWED.
// Amount is a flat per-day charge from settings, not a per-task multiplier.
model Debt {
  id                String    @id @default(cuid())
  dayId             String    @unique
  day               Day       @relation(fields: [dayId], references: [id], onDelete: Cascade)
  amountCents       Int       @default(700)
  gofundmeUrl       String?
  // Settlement proof = an uploaded confirmation email/receipt file.
  // donationProof is the legacy free-text column (URLs or receipt IDs from
  // before file uploads existed); new settlements populate the Path/Name/Mime
  // /Size columns below.
  donationProof     String?
  donationProofPath String?
  donationProofName String?
  donationProofMime String?
  donationProofSize Int?
  donationProofNote String?
  settledAt         DateTime?
  createdAt         DateTime  @default(now())
}

model Settings {
  id                  String   @id @default("singleton")
  userId              String   @unique @default("jordan")
  defaultAmountCents  Int      @default(700)
  weeklyVoidBudget    Int      @default(2)
  timezone            String   @default("America/Toronto")
  gofundmeUrlsJson    String   @default("[]")
  updatedAt           DateTime @updatedAt
}
